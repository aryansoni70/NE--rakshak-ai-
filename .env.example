# ==============================================================================
# NE-RAKSHAK AI — Environment Configuration & API Keys
# ==============================================================================
# Copy this file to '.env' in this directory.
# ==============================================================================

# 1. Routing Engine (Choose Google Routes or OpenRouteService)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here

# 2. Weather & Precipitation Data
WEATHERAPI_KEY=your_weatherapi_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# 3. LLM for Tactical Decision Directives (Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here

# 4. Satellite Earth Observation
COPERNICUS_CLIENT_ID=your_copernicus_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_secret_here
MOSDAC_USERNAME=your_mosdac_username_here
MOSDAC_PASSWORD=your_mosdac_password_here
