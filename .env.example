# 1. Routing Engine (Choose Google Routes or OpenRouteService)
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# 2. Weather & Precipitation Data
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=

# 3. LLM for Tactical Decision Directives (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. Satellite Earth Observation
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
