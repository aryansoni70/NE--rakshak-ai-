# ==============================================================================
# NE-RAKSHAK AI — Environment Configuration & API Keys
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' folder or root folder.
# All external APIs are OPTIONAL. If a key is left blank, the platform automatically
# uses high-precision offline calibrated models and free public data feeds.
# ==============================================================================

# 1. Routing Engine (Choose Google Routes or OpenRouteService)
# Get Google Routes Key: https://console.cloud.google.com/ (Enable 'Routes API')
GOOGLE_MAPS_API_KEY=

# Alternative Free Routing: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# 2. Weather & Precipitation Data
# Open-Meteo is used by default with NO key required.
# If using WeatherAPI or OpenWeatherMap for secondary validation:
# WeatherAPI: https://www.weatherapi.com/
WEATHERAPI_KEY=
# OpenWeatherMap: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# 3. LLM for Tactical Decision Directives (Gemini or OpenAI)
# Google AI Studio (Free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Or OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. Satellite Earth Observation (Phase 2 / Advanced)
# Copernicus Data Space Ecosystem (Sentinel-1 SAR / Sentinel-2):
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ISRO Space Applications Centre (MOSDAC):
# Register at: https://www.mosdac.gov.in/
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
